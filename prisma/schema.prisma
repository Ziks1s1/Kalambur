generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

enum TaskDifficulty {
  BASIC
  MEDIUM
  HARD
}

enum SourceStatus {
  DEMO_SEED
  VERIFIED
  IMPORTED
}

enum VariantStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum AttemptStatus {
  DRAFT
  UPLOADED
  SUBMITTED
  CHECKED
  FAILED
}

model User {
  id             String             @id @default(cuid())
  telegramId     String             @unique
  username       String?
  firstName      String
  lastName       String?
  role           UserRole           @default(STUDENT)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  variants       GeneratedVariant[]
  attempts       UserAttempt[]
  statistics     UserStatistics[]
  selectedSubjects UserSubject[]

  @@index([role])
}

model Subject {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  taskTypes      ExamTaskType[]
  taskBankItems  TaskBankItem[]
  variants       GeneratedVariant[]
  statistics     UserStatistics[]
  selectedByUsers UserSubject[]

  @@index([isActive])
}

model ExamTaskType {
  id             String           @id @default(cuid())
  subjectId      String
  taskNumber     Int
  code           String
  name           String
  description    String
  maxScore       Int
  difficulty     TaskDifficulty
  tags           String[]
  sourceStatus   SourceStatus     @default(DEMO_SEED)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  taskBankItems  TaskBankItem[]

  @@unique([subjectId, code])
  @@index([subjectId, taskNumber])
  @@index([isActive, sourceStatus])
}

model TaskBankItem {
  id                String              @id @default(cuid())
  subjectId         String
  taskTypeId        String
  year              Int?
  sourceType        String
  sourceUrl         String?
  title             String
  problemText       String
  assetsJson        Json?
  maxScore          Int
  metaJson          Json?
  sourceStatus      SourceStatus        @default(DEMO_SEED)
  isPublished       Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  subject           Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  taskType          ExamTaskType        @relation(fields: [taskTypeId], references: [id], onDelete: Cascade)
  criteria          TaskCriterion[]
  referenceSolution ReferenceSolution?
  variantTasks      VariantTask[]

  @@index([subjectId, taskTypeId])
  @@index([isPublished, sourceStatus])
}

model TaskCriterion {
  id             String       @id @default(cuid())
  taskBankItemId String
  code           String
  title          String
  description    String
  maxScore       Int
  sortOrder      Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  taskBankItem   TaskBankItem @relation(fields: [taskBankItemId], references: [id], onDelete: Cascade)

  @@unique([taskBankItemId, code])
  @@index([taskBankItemId, sortOrder])
}

model ReferenceSolution {
  id             String       @id @default(cuid())
  taskBankItemId String       @unique
  solutionText   String?
  correctAnswer  String?
  notes          String?
  rubricJson     Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  taskBankItem   TaskBankItem @relation(fields: [taskBankItemId], references: [id], onDelete: Cascade)
}

model GeneratedVariant {
  id          String         @id @default(cuid())
  userId      String
  subjectId   String
  status      VariantStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  tasks       VariantTask[]

  @@index([userId, subjectId, status])
}

model VariantTask {
  id             String           @id @default(cuid())
  variantId      String
  taskBankItemId String
  orderIndex     Int
  isCompleted    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  variant        GeneratedVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  taskBankItem   TaskBankItem     @relation(fields: [taskBankItemId], references: [id], onDelete: Cascade)
  attempts       UserAttempt[]

  @@unique([variantId, orderIndex])
  @@index([variantId, isCompleted])
}

model UserAttempt {
  id          String        @id @default(cuid())
  userId      String
  variantTaskId String
  comment     String?
  status      AttemptStatus @default(DRAFT)
  submittedAt DateTime?
  checkedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantTask VariantTask   @relation(fields: [variantTaskId], references: [id], onDelete: Cascade)
  files       AttemptFile[]
  aiCheck     AICheck?

  @@index([userId, status])
  @@index([variantTaskId, createdAt])
}

model AttemptFile {
  id         String      @id @default(cuid())
  attemptId  String
  sortOrder  Int         @default(0)
  fileUrl    String
  storageKey String
  mimeType   String
  size       Int
  width      Int?
  height     Int?
  createdAt  DateTime    @default(now())
  attempt    UserAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([attemptId, sortOrder])
}

model UserSubject {
  userId    String
  subjectId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([userId, subjectId])
  @@index([subjectId])
}

model AICheck {
  id                  String           @id @default(cuid())
  attemptId           String           @unique
  model               String
  totalScore          Int
  maxScore            Int
  expertComment       String
  strengthsJson       Json
  mistakesJson        Json
  recommendationsJson Json
  confidence          Float
  extractedText       String?
  rawJson             Json
  createdAt           DateTime         @default(now())
  attempt             UserAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  criterionScores     CriterionScore[]

  @@index([createdAt])
}

model CriterionScore {
  id             String   @id @default(cuid())
  aiCheckId      String
  criterionCode  String
  criterionTitle String
  awardedScore   Int
  maxScore       Int
  comment        String
  createdAt      DateTime @default(now())
  aiCheck        AICheck  @relation(fields: [aiCheckId], references: [id], onDelete: Cascade)

  @@index([aiCheckId])
}

model UserStatistics {
  id               String   @id @default(cuid())
  userId           String
  subjectId        String
  solvedCount      Int      @default(0)
  checkedCount     Int      @default(0)
  averageScore     Float    @default(0)
  completionRate   Float    @default(0)
  weakTopicsJson   Json
  strongTopicsJson Json
  lastCalculatedAt DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject          Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}
